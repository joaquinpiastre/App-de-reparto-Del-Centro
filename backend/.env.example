NODE_ENV=production
PORT=3000
# PostgreSQL (Railway u otro). Sin credenciales reales en el repositorio.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Secreto largo y aleatorio para firmar JWT (generar uno nuevo por entorno).
JWT_SECRET=cambiar-por-secreto-largo-y-aleatorio

# Orígenes permitidos para CORS (web admin). Separados por coma, sin barra final.
CORS_ORIGIN=https://tu-dominio.vercel.app,http://localhost:8081

# Misma clave que EXPO_PUBLIC_API_KEY_MOBILE en la app (opcional; recomendado en producción).
API_KEY_MOBILE=cambiar-api-key-mobile

# PIN por defecto al crear repartidores sin PIN explícito. Definir uno distinto en producción.
DEMO_PIN=cambiar-pin-repartidores
